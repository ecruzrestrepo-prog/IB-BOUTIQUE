# Única fuente de configuración. Copiar a .env y completar localmente.
# No se leen variables del shell ni secrets.toml. No se interpolan ${variables}.
USER_DB=
DB_PASSWORD=
DB_DSN=
DB_SCHEMA=EMILIO_CRUZ10
WALLET_DIR=./Wallet_ADBG05
WALLET_KEY=
ORACLE_MODE=thin
ORACLE_CLIENT_LIB_DIR=

STREAMLIT_PORT=8501
NGROK_ENABLED=true
NGROK_AUTHTOKEN=
NGROK_BASIC_USER=
# Contraseña compartida de 8–128 caracteres, distinta de las claves Oracle.
NGROK_BASIC_PASSWORD=

MAX_ROWS=20000
QUERY_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=10
POOL_WAIT_TIMEOUT_SECONDS=30
POOL_MAX_CONNECTIONS=4
